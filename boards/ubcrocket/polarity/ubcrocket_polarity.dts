/dts-v1/;
#include "ubcrocket_polarity-common.dtsi"

/ {
	model = "UBC Rocket Flight Controller / Project Polarity 2025-26 Rev 1.0";
	compatible = "ubcrocket,ubcrocket_polarity";

	#address-cells = <1>;
	#size-cells = <1>;

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram1;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

    leds {
		compatible = "gpio-leds";

		// led0: driven by vtx_power.c as a visual mirror of the vtx_pwr
		// output on PD6 (lit = VTX/RunCam rail powered).
		green_led: green-led {
			gpios = <&gpioa 10 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};

        red_led: red-led {
			gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
			label = "Red LED";
		};
	};

	outputs {
		compatible = "gpio-leds";

		// VTX/RunCam power switch on PD6 (confirmed by hardware team).
		// PD6/PD5 are the USART2 RX/TX pair on this package, but the pair is
		// broken up here: PD6 is a plain GPIO output and PD5 is left
		// unconfigured. See the usart2 note below.
		// Active level assumed high.
		vtx_pwr: vtx-pwr {
			gpios = <&gpiod 6 GPIO_ACTIVE_HIGH>;
			label = "VTX RunCam Power";
		};
	};

	aliases {
        led0 = &green_led;
        led1 = &red_led;
        accel0 = &accel0;
        gyro0 = &gyro0;
        baro0 = &baro0;
        baro1 = &baro1;
        pyro0 = &pyro0;
        radio0 = &radio0;
        sdmmc1 = &sdmmc1;
        vtx-pwr = &vtx_pwr;
        runcam-uart = &uart4;
    };
};

// RunCam control UART on UART4 (confirmed by hardware team).
// Pin pair is PD1 (TX) / PD0 (RX); the earlier PA0/PA1 assumption was wrong.
// Baud is the RunCam Device Protocol default.
&uart4 {
    status = "okay";
    pinctrl-0 = <&uart4_tx_pd1 &uart4_rx_pd0>;
    pinctrl-names = "default";
    current-speed = <115200>;
};

// USART2 is intentionally absent. The RFD900x modem serial was assumed to
// live here (first on PA2/PA3, then on the PD5 TX / PD6 RX pair), but the
// modem's data serial is fed by the ulysses-gnss-radio board and FALCON
// driving a UART TX into it contends with that path. The pair is now split
// up: PD6 is the vtx_pwr GPIO output (see the outputs node above) and PD5 is
// left unconfigured. The SoC dtsi leaves usart2 disabled and nothing needs
// it: remote AT reconfiguration goes through the GNSS board's SPI
// passthrough opcodes instead (firmware/src/radio/rfd900x.c).

// Enable and configure SPI2
&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_sck_pa5 &spi1_mosi_pa7 &spi1_miso_pa6>;
    pinctrl-names = "default";

    cs-gpios = <&gpioe 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
               <&gpioe 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

    // Pyro board CS on PE14
    pyro0: pyro0@0 {
        status = "okay";
        compatible = "vnd,spi-device";
        reg = <0>;
        spi-max-frequency = <1000000>;
    };

    // Radio board CS on PE8
    radio0: radio0@1 {
        status = "okay";
        compatible = "vnd,spi-device";
        reg = <1>;
        spi-max-frequency = <1000000>;
    };
};

// Enable and configure SPI2
&spi2 {
    status = "okay";
    pinctrl-0 = <&spi2_sck_pb10 &spi2_mosi_pc1 &spi2_miso_pc2>;
    pinctrl-names = "default";

    // Chip select pins: Accel on PD15, Gyro on PC7, Baro on PD8
    cs-gpios = <&gpiod 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, <&gpioc 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, <&gpiod 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

    // BMI088 Accelerometer
    accel0: bmi088-accel@0 {
        status = "okay";
        compatible = "bosch,bmi08x-accel";
        reg = <0>;
        spi-max-frequency = <10000000>;

        // Required properties:  https://docs.zephyrproject.org/latest/build/dts/api/bindings/sensor/bosch%2Cbmi08x-accel-spi.html
        accel-hz = "400";
        accel-fs = <24>;

        // Interrupt pins
        // int-gpios = <&gpiod 12 GPIO_ACTIVE_HIGH>;
        // int2-gpios = <&gpiod 14 GPIO_ACTIVE_HIGH>;
    };

    // BMI088 Gyroscope
    gyro0: bmi088-gyro@1 {
        status = "okay";
        compatible = "bosch,bmi08x-gyro";
        reg = <1>;
        spi-max-frequency = <10000000>;

        // Required properties: https://docs.zephyrproject.org/latest/build/dts/api/bindings/sensor/bosch%2Cbmi08x-gyro-spi.html
        gyro-hz = "1000_116";
        gyro-fs = <2000>;

        // Interrupt pins
        // int-gpios = <&gpiod 11 GPIO_ACTIVE_HIGH>;
        // int4-gpios = <&gpiod 10 GPIO_ACTIVE_HIGH>;
    };

    //MS5611 Barometer (same driver as ms5607)
    baro0: ms5611@2 {
        status = "okay";
        compatible = "meas,ms5611";
        reg = <2>;
        spi-max-frequency = <10000000>;
    };
};

// Enable and configure SPI4
&spi4 {
    status = "okay";
    pinctrl-0 = <&spi4_sck_pe12 &spi4_mosi_pe6 &spi4_miso_pe5>;
    pinctrl-names = "default";
    cs-gpios = <&gpiod 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, <&gpioe 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

    baro1: ms5607@1 {
        status = "okay";
        compatible = "meas,ms5607";
        reg = <1>;
        spi-max-frequency = <10000000>;
    };
};

// Enable and configure SDMMC1
&sdmmc1 {
    status = "okay";
    disk-name = "SDMMC";
    bus-width = <4>;
    pinctrl-0 = <&sdmmc1_ck_pc12 &sdmmc1_cmd_pb2 &sdmmc1_d0_pb13 &sdmmc1_d1_pc9 &sdmmc1_d2_pc10 &sdmmc1_d3_pc11>;
    pinctrl-names = "default";
    clk-div = <2>;  // Set clock divider to reduce frequency
};
